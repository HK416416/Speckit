{
  "experiment_name": "max_seqs_low",
  "description": "并发梯度: seqs=8, 轻微排队",
  "model": "Qwen/Qwen2.5-1.5B-Instruct",
  "vllm_args": {
    "max-model-len": 1024,
    "gpu-memory-utilization": 0.80,
    "max-num-seqs": 8,
    "enforce-eager": true,
    "compilation-config": {"mode": "NONE"},
    "enable-prefix-caching": false,
    "enable-chunked-prefill": false
  }
}
